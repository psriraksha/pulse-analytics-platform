NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/saas_analytics

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - comma separated origins allowed to call the API/dashboard
CORS_ORIGIN=http://localhost:3000

# Tracking script CDN base (where collect.js is served from)
TRACKING_SCRIPT_BASE_URL=http://localhost:5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
